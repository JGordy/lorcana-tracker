        "@types/node": "^22",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "jsdom": "^30.0.1",
        "lint-staged": "^15.5.2",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.0.3",
        "vitest": "^4.1.10"
