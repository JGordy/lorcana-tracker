    },
    "dependencies": {
        "@mantine/core": "^9.5.1",
        "@mantine/hooks": "^9.5.1",
        "@react-router/node": "^8",
        "@react-router/serve": "^8",
        "@tabler/icons-react": "^3.46.0",
        "appwrite": "^26.2.0",
        "html-to-image": "^1.11.11",
        "idb-keyval": "^6.3.0",
        "isbot": "^5.1.36",
        "lz-string": "^1.5.0",
        "node-appwrite": "^28.0.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^8",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@react-router/dev": "^8",
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
